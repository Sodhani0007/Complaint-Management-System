# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaints_db

GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

MAX_UPLOAD_SIZE_MB=10
UPLOAD_STORAGE_DIR=./uploaded_documents
