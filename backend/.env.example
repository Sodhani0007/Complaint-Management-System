# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaints_db

GROQ_API_KEY=your_groq_api_key_here
# Groq deprecated the assignment's originally-specified models
# (gemma2-9b-it, llama-3.3-70b-versatile) — using their current
# recommended replacements. Check https://console.groq.com/docs/deprecations
# if extraction starts failing again in the future.
GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

MAX_UPLOAD_SIZE_MB=10
UPLOAD_STORAGE_DIR=./uploaded_documents
